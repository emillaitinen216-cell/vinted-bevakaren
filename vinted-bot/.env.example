# Kopiera till .env och fyll i det du använder. .env checkas aldrig in i git.

# Telegram: enklast är att köra  python vinted_bot.py --telegram  som fyller i båda åt dig
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord: Serverinställningar › Integrationer › Webhooks › Ny webhook › Kopiera URL
DISCORD_WEBHOOK_URL=

# ntfy: hitta på ett svårgissat ämnesnamn och prenumerera på det i ntfy-appen
NTFY_TOPIC=
